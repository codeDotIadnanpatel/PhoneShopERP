<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PhoneShopErp.Migrations</RootNamespace>
    <!--
      Migration runner only. It is never referenced by the API and never runs at
      application startup (ADR-0014 / P01-WP01).
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
