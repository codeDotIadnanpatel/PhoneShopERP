    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhoneShopErp.Modules.Tenancy.Application\PhoneShopErp.Modules.Tenancy.Application.csproj" />
    <ProjectReference Include="..\..\src\PhoneShopErp.Modules.IdentityAccess.Application\PhoneShopErp.Modules.IdentityAccess.Application.csproj" />
    <ProjectReference Include="..\..\src\PhoneShopErp.Modules.SaasPlatform.Application\PhoneShopErp.Modules.SaasPlatform.Application.csproj" />
    <ProjectReference Include="..\..\src\PhoneShopErp.Platform\PhoneShopErp.Platform.csproj" />
  </ItemGroup>

</Project>
