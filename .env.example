# Local development configuration template.
#
#   Copy this file to `.env` (which is git-ignored) for local development only.
#   Never commit `.env`, real credentials or customer data.
#
# Production and CI secrets come from the deployment platform's secret store,
# not from files in this repository. CI must run without any developer secrets
# (Phase 00 P00-W04-T01).

# Required by docker-compose.yml for the local PostgreSQL container.
# Use a throwaway local value; it must not match any real environment.
POSTGRES_PASSWORD=

# Optional local overrides.
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:5080

# Deliberately absent: application connection strings.
# The API does not connect to PostgreSQL yet. Adding a connection string before
# D-001 (tenant context and RLS session propagation) and D-003 (physical database
# conventions) are approved would harden an unapproved design.
